# =====================================================================
# Copia este archivo a .env y llena los valores.
# .env esta en .gitignore: NUNCA se commitea ni se comparte por chat.
# En produccion estos valores van en Vercel > Settings > Environment Variables.
# =====================================================================

# === Base de datos ===
# Vacio  -> SQLite local en data/shop.db (desarrollo)
# Supabase -> postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Cambiar esta sola variable migra la tienda entera. No hay nada mas que tocar.
DATABASE_URL=

# === Stripe ===
# https://dashboard.stripe.com/apikeys
# Empieza con las llaves de TEST (sk_test_ / pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Sale al crear el webhook en https://dashboard.stripe.com/webhooks
# Endpoint: https://www.zeuzdnc.com/webhook/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#          checkout.session.async_payment_failed, checkout.session.expired
# Sin este valor el webhook rechaza todo: es lo que impide que alguien nos
# mande un POST falso diciendo que una orden fue pagada.
STRIPE_WEBHOOK_SECRET=

# === Mercado Pago ===
# https://www.mercadopago.com.mx/developers/panel/credentials
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# "sandbox" o "production"
MP_ENV=sandbox

# === Panel de administracion ===
# Sin este valor el panel /admin queda CERRADO (no abierto). Usa algo largo.
ADMIN_PASSWORD=

# === Avisos de pedidos ===
# A donde llegan los avisos de pedido pagado (separa varios con comas).
NOTIFY_EMAIL=eduardo@voxa.mx
# https://resend.com/api-keys — si esta vacio, el aviso solo se registra en el log.
RESEND_API_KEY=
# Remitente. Requiere dominio verificado en Resend; mientras tanto usa el de pruebas.
NOTIFY_FROM=ZEUZ DNC <onboarding@resend.dev>

# === Tienda ===
# URL publica, sin slash final. Construye las URLs de retorno de las pasarelas:
# si esto esta mal, el cliente paga y aterriza en una pagina que no existe.
# Local: http://localhost:5001  (5000 lo agarra AirPlay en macOS)
# Prod:  https://www.zeuzdnc.com
PUBLIC_BASE_URL=http://localhost:5001

# Correo de soporte que se muestra en el pie de pagina.
SUPPORT_EMAIL=eduardo@voxa.mx

# Ficha publica de iZEUZ. Dejala vacia hasta que Apple publique la app;
# la tienda muestra "Proximamente" mientras tanto.
# Ejemplo: https://apps.apple.com/mx/app/izeuz/id1234567890
APP_STORE_URL=

# === Flask ===
# Firma las cookies de sesion, incluida la del panel. Cambiala en produccion.
FLASK_SECRET=cambia-esta-clave-en-produccion
FLASK_DEBUG=0
