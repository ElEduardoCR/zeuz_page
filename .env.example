# === Mercado Pago ===
# Sacalas en https://www.mercadopago.com.mx/developers/panel/credentials
# TEST primero (sandbox), LIVE cuando vayas a produccion.
MP_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_DE_TEST
MP_PUBLIC_KEY=APP_USR-TU_PUBLIC_KEY_DE_TEST

# Entorno: "sandbox" o "production"
MP_ENV=sandbox

# URL publica de tu tienda (sin slash al final)
# En local: http://localhost:5001  (5000 lo agarra AirPlay en macOS)
# En prod:  https://zeus-dnc.com
PUBLIC_BASE_URL=http://localhost:5001

# Flask
FLASK_SECRET=cambia-esta-clave-en-produccion
FLASK_DEBUG=0
